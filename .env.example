# StudentTools.cyou — Environment Variables Template

# Core Site URL (Used for Canonical URLs, OpenGraph, and Sitemaps)
NEXT_PUBLIC_SITE_URL=https://studenttools.cyou

# Gemini API Configuration (Server-Side Only — NEVER prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Automated Editorial Pipeline Settings
BLOG_AUTOPUBLISH_ENABLED=false
BLOG_DAILY_LIMIT=1
BLOG_PUBLISH_TIME=09:00
BLOG_TIMEZONE=Asia/Kolkata
CRON_SECRET=

# Admin Authentication Secret (Server-Side Only)
ADMIN_SECRET_KEY=

# Google Sheets API Queue (Production)
GOOGLE_SHEETS_SPREADSHEET_ID=1n5fsm9OPkQ1XpUNnlxLcLIN_Jl2SKMWa8dNN3vFbKDI
GOOGLE_SHEETS_WORKSHEET_NAME=Topics
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Database / Supabase Storage (Source of Truth for Published Articles)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Google AdSense (Auto Ads — Decoupled from Publishing Engine)
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-1405060407756207

# Google Search Console Verification (Optional)
NEXT_PUBLIC_GSC_VERIFICATION=
